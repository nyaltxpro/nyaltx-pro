# NYAX Platform Smart Contract Addresses
# Copy this file to .env.local and update with your deployed contract addresses

# Smart Contract Addresses (update after deployment)
NEXT_PUBLIC_NYAX_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MULTISIG_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_VESTING_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000

# Network Configuration
NEXT_PUBLIC_CHAIN_ID=1
NEXT_PUBLIC_NETWORK_NAME=mainnet

# API Keys (optional for enhanced features)
NEXT_PUBLIC_INFURA_PROJECT_ID=your_infura_project_id
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key

# WalletConnect Project ID (for wallet connections)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Token Sale Configuration
NEXT_PUBLIC_SALE_ENABLED=true
NEXT_PUBLIC_SALE_PRICE_ETH=0.001
NEXT_PUBLIC_SALE_MIN_PURCHASE=100
NEXT_PUBLIC_SALE_MAX_PURCHASE=100000

# Admin Configuration
NEXT_PUBLIC_ADMIN_MODE=false
