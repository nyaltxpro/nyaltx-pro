    "add-owner": "hardhat run scripts/add-owner.js --network sepolia",
    "get-owners": "hardhat run scripts/get-owners.js --network sepolia",
    "deploy-new-multisig": "hardhat run scripts/deploy-new-multisig.js --network sepolia"
