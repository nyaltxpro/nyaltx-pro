    "deploy-dao:polygon": "hardhat run scripts/deploy-dao.js --network polygon",
    "deploy-dao:bsc": "hardhat run scripts/deploy-dao.js --network bsc",
    "deploy-dao:arbitrum": "hardhat run scripts/deploy-dao.js --network arbitrum",
    "verify:sepolia": "hardhat run scripts/verify.js --network sepolia",
    "verify:mainnet": "hardhat run scripts/verify.js --network mainnet",
    "verify-contracts:sepolia": "hardhat run scripts/verify-contracts.js --network sepolia",
    "verify-contracts:mainnet": "hardhat run scripts/verify-contracts.js --network mainnet",
